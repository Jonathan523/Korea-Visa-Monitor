# 必填：签证申请信息
VISA_PASSPORT_NUMBER=
VISA_ENGLISH_NAME=
VISA_BIRTHDAY=YYYY-MM-DD

# 必填：Cron 接口鉴权（请使用至少 16 位随机字符串）
CRON_SECRET=

# 必填：Vercel 无持久化磁盘，使用 Upstash Redis 保存上次查询状态
VISA_STATE_STORAGE=upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
VISA_UPSTASH_KEY=krvisa:visa_state

# PushDeer（默认）
VISA_PUSH_CHANNEL=pushdeer
VISA_PUSHDEER_KEY=
VISA_PUSHDEER_ENDPOINT=https://api2.pushdeer.com/message/push

# Vercel Cron 已负责限制执行时段，因此函数内时间窗口保持全天
VISA_WINDOW_START=00:00
VISA_WINDOW_END=23:59
VISA_DEBUG=0

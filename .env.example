# 必填：签证申请信息
VISA_PASSPORT_NUMBER=
VISA_ENGLISH_NAME=
VISA_BIRTHDAY=YYYY-MM-DD

# Modal 默认使用自动创建的持久化 Volume，无需配置 Upstash/S3
VISA_STATE_STORAGE=local
VISA_STATE_FILE=/state/visa_state.json

# S3 / S3 兼容存储（可选；使用时注释上面的 Modal Volume 配置并取消以下注释）
# VISA_STATE_STORAGE=s3
# VISA_S3_BUCKET=my-bucket
# VISA_S3_KEY=visa_state.json
# VISA_S3_REGION=ap-northeast-2
# VISA_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Upstash Redis（可选；使用时注释上面的 Modal Volume 配置并取消以下注释）
# VISA_STATE_STORAGE=upstash
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# VISA_UPSTASH_KEY=krvisa:visa_state

# PushDeer（默认）
VISA_PUSH_CHANNEL=pushdeer
VISA_PUSHDEER_KEY=
VISA_PUSHDEER_ENDPOINT=https://api2.pushdeer.com/message/push

# Server酱（可选；使用时注释上面的 PushDeer 配置并取消以下注释）
# VISA_PUSH_CHANNEL=serverchan
# VISA_SERVERCHAN_KEY=

# 与 modal_app.py 中的定时范围一致（UTC+8）
VISA_WINDOW_START=08:00
VISA_WINDOW_END=20:00

# 调试模式（可选）
# VISA_DEBUG=1
